PORT=4000
# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net
MONGODB_DB=daily_notebook
# Supabase project URL; the API verifies Supabase access tokens against its JWKS
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Only for projects still on the legacy shared JWT secret (Settings > API > JWT secret)
SUPABASE_JWT_SECRET=
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:8081
# Publishable key; lets the API check tokens with Supabase Auth if the project still signs with the legacy secret
SUPABASE_PUBLISHABLE_KEY=
